<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app publish its Continue Watching items to the TV home screen's Watch Next row. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- Only APKs signed with this app's key (the Lumora Home launcher) may read the home rows. -->
    <permission
        android:name="com.iptvcinema.tv.permission.READ_LAUNCHER_ROWS"
        android:protectionLevel="signature" />

    <!-- Voice search: lets the app see the system speech recognizer on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".app.IptvCinemaApp"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.IptvCinema"
        android:usesCleartextTraffic="true">

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.IptvCinema.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Watch Next cards on the home screen open lumora://play?type=…&id=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="play"
                    android:scheme="lumora" />
            </intent-filter>
        </activity>

        <!-- Home rows for the Lumora Home launcher; serves a snapshot file, never the database. -->
        <provider
            android:name=".core.tvhome.launcher.LauncherContentProvider"
            android:authorities="com.iptvcinema.tv.launcher"
            android:exported="true"
            android:permission="com.iptvcinema.tv.permission.READ_LAUNCHER_ROWS" />

        <receiver
            android:name=".core.tvhome.WatchNextRemovedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.WATCH_NEXT_PROGRAM_BROWSABLE_DISABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
